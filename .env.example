# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# Chọn nhà cung cấp LLM mặc định: openai | gemini | groq | deepseek | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# 1. OpenAI (Khuyến nghị: gpt-4o-mini, gpt-4o)
OPENAI_API_KEY=sk-your-openai-key-here

# 2. Google Gemini (Khuyến nghị: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_API_KEY=your-gemini-key-here

# 3. Groq - Tốc độ siêu nhanh (Khuyến nghị: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=your-groq-key-here

# 4. DeepSeek (Khuyến nghị: deepseek-chat, deepseek-reasoner)
DEEPSEEK_API_KEY=your-deepseek-key-here

# 5. Anthropic Claude (Khuyến nghị: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022)
ANTHROPIC_API_KEY=your-anthropic-key-here

# 6. Local / Custom OpenAI Compatible (Ollama, vLLM, OpenRouter)
# Với Ollama: OPENAI_BASE_URL=http://localhost:11434/v1, LLM_MODEL=qwen2.5:7b
OPENAI_BASE_URL=


# ---- Database ----
# Local default (SQLite file under data/, gitignored):
DATABASE_URL=sqlite:///./data/app.db
# Integration / Compose PostgreSQL:
# DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus24
DEMO_AUTH_ENABLED=true
SESSION_TTL_SECONDS=28800
PREVIEW_TTL_SECONDS=1800
IDEMPOTENCY_TTL_SECONDS=86400
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
