# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
# AGENT_MODE=stub giữ StubAgent (mặc định test/CI). langgraph mới tạo CampusAgent + model thật.
# G3 E2E đặt AGENT_MODE=langgraph và RAG_MODE=corpus cùng lúc cho API và worker; không ghi langgraph vào .env của data/app.db.
AGENT_MODE=stub
# RAG_MODE=stub giữ StubRag (rỗng / insufficient_evidence). corpus dùng tài liệu demo đóng gói có provenance.
RAG_MODE=stub
# Provider được factory hỗ trợ: openai | google | groq | openai_compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# 1. OpenAI (ví dụ: gpt-4o-mini, gpt-4o)
OPENAI_API_KEY=sk-your-openai-key-here

# 2. Google Gemini — ưu tiên GOOGLE_API_KEY, fallback GEMINI_API_KEY
# Demo EDU-14 đã kiểm chứng: LLM_PROVIDER=gemini LLM_MODEL=gemini-3.5-flash-lite
# LLM_PROVIDER=google
# LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=your-gemini-key-here
GEMINI_API_KEY=your-gemini-key-here

# 3. Groq (ví dụ: llama-3.3-70b-versatile). Khác với model Grok của xAI.
# LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here

# 4. OpenAI-compatible (vLLM, Ollama, OpenRouter). Bắt buộc OPENAI_BASE_URL.
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=qwen2.5:7b
# OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=


# ---- Database ----
# Local default (SQLite file under data/, gitignored):
DATABASE_URL=sqlite:///./data/app.db
# Integration / Compose PostgreSQL:
# DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus24
DEMO_AUTH_ENABLED=true
SESSION_TTL_SECONDS=28800
PREVIEW_TTL_SECONDS=1800
IDEMPOTENCY_TTL_SECONDS=86400
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100,http://localhost:3101,http://127.0.0.1:3101,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
