# LLM Provider
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Alternative: Gemini
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=xxx
# GEMINI_MODEL=gemini-1.5-flash

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ChromaDB
CHROMA_PERSIST_DIR=./vectorstore
CHROMA_COLLECTION=vinuni_docs

# Retrieval
SCORE_THRESHOLD=0.3
TOP_K=5
RRF_K=60

# Crawl
CRAWL_DELAY=2
